---
import { navigation } from '../../data/site';
import { withBase } from '../../lib/url';
import { installer, portable, release } from '../../lib/releases';
import Icon from '../ui/Icon.astro';
import DownloadSplit from '../marketing/DownloadSplit.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => {
  const path = href.split('#')[0];
  return path !== '/' && current.startsWith(path);
};

const version = release.tag ? release.tag.replace(/^v/, '') : null;
---

<header class="site-header">
  <div class="wrap site-nav" data-nav>
    <a class="site-brand" href={withBase('/')}>
      <img src={withBase('/assets/images/brand/aetherfox-logo.webp')} alt="" width="34" height="34" />
      Aetherfox
    </a>

    <nav class="site-nav__links" data-nav-links aria-label="Main">
      {
        navigation.map((item) => (
          <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-nav__actions">
      {
        installer ? (
          <DownloadSplit
            variant="compact"
            installerUrl={installer.url}
            portableUrl={portable?.url ?? installer.url}
            version={version}
            installerSize={installer.size}
            portableSize={portable?.size ?? 0}
            label="Download"
          />
        ) : (
          <a class="btn" href={withBase('/download')}>
            <Icon name="dl" />
            Download
          </a>
        )
      }
      <button
        class="site-nav__toggle"
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Icon name="mn" />
      </button>
    </div>
  </div>
</header>
