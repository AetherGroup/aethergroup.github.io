---
import { formatSize } from '../../lib/releases';
import Icon from '../ui/Icon.astro';

type Props = {
  installerUrl: string;
  portableUrl: string;
  version: string | null;
  installerSize: number;
  portableSize: number;
  variant?: 'panel' | 'compact' | 'inverse';
  label?: string;
  showMeta?: boolean;
};

const {
  installerUrl,
  portableUrl,
  version,
  installerSize,
  portableSize,
  variant = 'panel',
  label = 'Download for Windows',
  showMeta = variant === 'panel',
} = Astro.props;
---

<div class:list={['dl-split', `dl-split--${variant}`]} data-split>
  <a class="dl-split__main" href={installerUrl} download>
    {variant === 'compact' && <Icon name="dl" />}
    <span class="dl-split__label">{label}</span>
    {
      showMeta && (
        <span class="dl-split__meta">
          {version && (
            <>
              {version}
              {installerSize > 0 && ` · ${formatSize(installerSize)}`}
            </>
          )}
        </span>
      )
    }
  </a>

  <button
    class="dl-split__toggle"
    type="button"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Other download options"
  >
    <Icon name="chev" />
  </button>

  <div class="dl-split__menu" role="menu" hidden>
    <a role="menuitem" href={portableUrl} download>
      <span class="dl-split__name">Portable</span>
      <span class="dl-split__note">No install · {formatSize(portableSize)}</span>
    </a>
    <a role="menuitem" href={installerUrl} download>
      <span class="dl-split__name">Installer</span>
      <span class="dl-split__note">Sets up Aetherfox · {formatSize(installerSize)}</span>
    </a>
  </div>
</div>

<script>
  for (const split of document.querySelectorAll<HTMLElement>('[data-split]')) {
    const toggle = split.querySelector<HTMLButtonElement>('.dl-split__toggle');
    const menu = split.querySelector<HTMLElement>('.dl-split__menu');
    if (!toggle || !menu) continue;

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      menu.hidden = false;
      menu.classList.remove('is-up');
      const rect = split.getBoundingClientRect();
      const spaceBelow = window.innerHeight - rect.bottom;
      if (spaceBelow < menu.offsetHeight + 24) menu.classList.add('is-up');
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      if (menu.hidden) open();
      else close();
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node | null;
      if (!menu.hidden && target && !split.contains(target)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
