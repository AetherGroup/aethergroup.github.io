---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { withBase } from '../../lib/url';

const posts = (await getCollection('news', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const format = (date: Date) =>
  new Intl.DateTimeFormat('en', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<PageLayout title="News" description="Release notes and updates from the Aetherfox team.">
  <section class="section">
    <div class="wrap">
      <div class="page-list__head">
        <h1 class="display">News</h1>
        <p>Releases, privacy work and the occasional design change.</p>
      </div>

      <div class="page-list__grid">
        {
          posts.map((post) => (
            <a class="card" href={withBase(`/news/${post.id}`)}>
              <div class="card__meta">
                <span>{post.data.category}</span>
                <span>·</span>
                <time datetime={post.data.date.toISOString()}>{format(post.data.date)}</time>
              </div>
              <span class="card__title">{post.data.title}</span>
              <p class="card__excerpt">{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</PageLayout>
