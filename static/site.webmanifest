{
  "name": "Aetherfox",
  "short_name": "Aetherfox",
  "description": "The browser with the extras left out.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0F0D16",
  "theme_color": "#6C5CE7",
  "icons": [
    {
      "src": "/assets/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/images/icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ]
}
